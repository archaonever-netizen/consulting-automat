# Database
DATABASE_URL=postgresql://user:password@localhost/chef_db

# Flask
SECRET_KEY=your-secret-key-here-change-in-production
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=change-me
FOUNDER_NAME=Основатель
FRONTEND_URL=http://127.0.0.1:5174

# Promptra API (для работы с LLM)
PROMPTRA_API_KEY=your-promptra-api-key

# Telegram secretary (local lab)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SECRETARY_OWNER_TELEGRAM_ID=
SECRETARY_LOCAL_USER_EMAIL=

# Декомпозиция целей (движок). По умолчанию — Promptra, направленный на Claude.
DECOMPOSITION_LLM_PROVIDER=promptra
DECOMPOSITION_MODEL=anthropic/claude-opus-4.8
DECOMPOSITION_MAX_RETRIES=2
# Нужен только при DECOMPOSITION_LLM_PROVIDER=anthropic (ключ только на сервере):
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Яндекс.Календарь OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:5055/auth/yandex/callback

# Яндекс Трекер OAuth connector
YANDEX_TRACKER_OAUTH_CLIENT_ID=your-yandex-tracker-oauth-client-id
YANDEX_TRACKER_OAUTH_CLIENT_SECRET=your-yandex-tracker-oauth-client-secret
YANDEX_TRACKER_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/api/tracker/oauth/callback
YANDEX_TRACKER_OAUTH_SCOPE=tracker:read tracker:write
# Use exactly one organization id type.
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_CLOUD_ORG_ID=
YANDEX_TRACKER_DEFAULT_QUEUE=
