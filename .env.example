# Database
DATABASE_URL=postgresql://user:password@localhost/chef_db

# Flask
SECRET_KEY=your-secret-key-here-change-in-production

# Promptra API (для работы с LLM)
PROMPTRA_API_KEY=your-promptra-api-key

# Декомпозиция целей (движок). По умолчанию — Promptra, направленный на Claude.
DECOMPOSITION_LLM_PROVIDER=promptra
DECOMPOSITION_MODEL=claude-opus-4.7
DECOMPOSITION_MAX_RETRIES=2
# Нужен только при DECOMPOSITION_LLM_PROVIDER=anthropic (ключ только на сервере):
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Яндекс.Календарь OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:5055/auth/yandex/callback
